{
  "manifest": {
    "format": "gaui/1",
    "id": "local-workshop",
    "version": "1.2.0",
    "name": "Local Workshop",
    "surfaces": [
      "admin.shell",
      "admin.overview",
      "chat.sidebar",
      "chat.messages",
      "chat.composer",
      "chat.navigation",
      "chat.followToolbar"
    ]
  },
  "views": {
    "admin.shell": {
      "layout": {
        "density": "compact",
        "align": "center",
        "hostOrder": "last"
      },
      "before": {
        "type": "stack",
        "style": {
          "gap": 8
        },
        "children": [
          {
            "type": "heading",
            "text": "Workshop navigation"
          },
          {
            "type": "each",
            "source": "navigation",
            "children": [
              {
                "type": "button",
                "bind": "item.label",
                "action": "navigate",
                "target": "item.id"
              }
            ]
          },
          {
            "type": "button",
            "text": "Back to chat",
            "action": "backToChat"
          }
        ]
      }
    },
    "admin.overview": {
      "layout": {
        "density": "compact",
        "align": "center",
        "hostOrder": "last"
      },
      "before": {
        "type": "grid",
        "style": {
          "columns": 2,
          "gap": 12
        },
        "children": [
          {
            "type": "heading",
            "bind": "title"
          },
          {
            "type": "text",
            "bind": "status"
          },
          {
            "type": "each",
            "source": "services",
            "children": [
              {
                "type": "row",
                "children": [
                  {
                    "type": "text",
                    "bind": "item.label"
                  },
                  {
                    "type": "badge",
                    "bind": "item.status"
                  }
                ]
              }
            ]
          },
          {
            "type": "button",
            "text": "Refresh overview",
            "action": "refreshOverview"
          }
        ]
      }
    },
    "chat.sidebar": {
      "layout": {
        "density": "compact",
        "align": "center",
        "hostOrder": "last"
      },
      "before": {
        "type": "grid",
        "style": {
          "columns": 2,
          "gap": 8,
          "padding": 8
        },
        "children": [
          {
            "type": "stack",
            "children": [
              {
                "type": "heading",
                "text": "Workshop navigation"
              },
              {
                "type": "badge",
                "bind": "status"
              }
            ]
          },
          {
            "type": "button",
            "text": "Manage conversations",
            "action": "manageSessions"
          },
          {
            "type": "button",
            "text": "Workspace settings",
            "action": "openSettings"
          }
        ]
      },
      "after": {
        "type": "row",
        "style": {
          "gap": 8
        },
        "children": [
          {
            "type": "text",
            "text": "Conversations"
          },
          {
            "type": "badge",
            "bind": "value"
          }
        ]
      }
    },
    "chat.messages": {
      "layout": {
        "density": "compact",
        "align": "center",
        "hostOrder": "last"
      },
      "before": {
        "type": "grid",
        "style": {
          "columns": 2,
          "gap": 8,
          "padding": 8
        },
        "children": [
          {
            "type": "stack",
            "children": [
              {
                "type": "heading",
                "text": "Workshop reading desk"
              },
              {
                "type": "badge",
                "bind": "status"
              }
            ]
          },
          {
            "type": "button",
            "text": "Follow latest",
            "action": "followLatest"
          }
        ]
      },
      "after": {
        "type": "row",
        "style": {
          "gap": 8
        },
        "children": [
          {
            "type": "text",
            "text": "Messages"
          },
          {
            "type": "badge",
            "bind": "value"
          }
        ]
      }
    },
    "chat.composer": {
      "layout": {
        "density": "compact",
        "align": "center",
        "hostOrder": "last"
      },
      "before": {
        "type": "grid",
        "style": {
          "columns": 2,
          "gap": 8,
          "padding": 8
        },
        "children": [
          {
            "type": "stack",
            "children": [
              {
                "type": "heading",
                "text": "Workshop writing desk"
              },
              {
                "type": "badge",
                "bind": "status"
              }
            ]
          },
          {
            "type": "button",
            "text": "Browse commands",
            "action": "openCommands"
          }
        ]
      },
      "after": {
        "type": "row",
        "style": {
          "gap": 8
        },
        "children": [
          {
            "type": "text",
            "text": "Attachments"
          },
          {
            "type": "badge",
            "bind": "value"
          }
        ]
      }
    },
    "chat.navigation": {
      "layout": {
        "density": "compact",
        "align": "stretch",
        "hostOrder": "first"
      },
      "content": {
        "type": "stack",
        "children": [
          {
            "type": "heading",
            "text": "Workshop navigation"
          },
          {
            "type": "badge",
            "bind": "status"
          },
          {
            "type": "row",
            "children": [
              {
                "type": "button",
                "text": "Start conversation",
                "action": "newChat"
              },
              {
                "type": "button",
                "text": "Browse conversations",
                "action": "manageSessions"
              },
              {
                "type": "button",
                "text": "Workspace settings",
                "action": "openSettings"
              },
              {
                "type": "button",
                "text": "Collapse navigation",
                "action": "collapseSidebar"
              }
            ]
          }
        ],
        "style": {
          "gap": 8,
          "padding": 8,
          "radius": 8
        }
      }
    },
    "chat.followToolbar": {
      "layout": {
        "density": "compact",
        "align": "stretch",
        "hostOrder": "first"
      },
      "content": {
        "type": "stack",
        "children": [
          {
            "type": "heading",
            "text": "Reading controls"
          },
          {
            "type": "badge",
            "bind": "status"
          },
          {
            "type": "row",
            "children": [
              {
                "type": "button",
                "text": "Return to latest",
                "action": "followLatest"
              }
            ]
          }
        ],
        "style": {
          "gap": 8,
          "padding": 8,
          "radius": 8
        }
      }
    }
  },
  "schema": {
    "accent": {
      "type": "color",
      "label": "Accent",
      "default": "#557766"
    },
    "density": {
      "type": "enum",
      "label": "Chat density",
      "default": "compact",
      "options": [
        "compact",
        "comfortable"
      ]
    }
  },
  "config": {}
}
